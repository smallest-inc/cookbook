# Get your API key from https://app.smallest.ai/dashboard/api-keys
SMALLEST_API_KEY=sk_...

# Populated automatically by `python scripts/setup_agent.py`.
# You can also set it manually after creating the agent in the dashboard.
AGENT_ID=

# The only value the app reads. EXPO_PUBLIC_* is inlined into the JS bundle,
# so never put a key here. The session server (../mobile_token_server) holds
# SMALLEST_API_KEY and AGENT_ID. iOS simulator: http://localhost:8787
# Android emulator: http://10.0.2.2:8787. Physical device: http://<your-LAN-IP>:8787
EXPO_PUBLIC_TOKEN_SERVER_URL=http://localhost:8787
