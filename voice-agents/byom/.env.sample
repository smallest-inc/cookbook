# Required for the crew to talk to the platform.
SMALLEST_API_KEY=sk_...

# Point the LLM at any OpenAI-compatible endpoint.
# Leave LLM_BASE_URL empty to use OpenAI.

# Example A: hosted Claude via an OpenAI-shim proxy.
# LLM_MODEL=claude-3-5-sonnet-20241022
# LLM_API_KEY=sk-ant-...
# LLM_BASE_URL=https://api.anthropic.com/v1

# Example B: local Ollama (local runs only).
# LLM_MODEL=llama3.2
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1

# Example C: Ollama exposed to a deployed crew via ngrok.
# Start ngrok with:  ngrok http 11434 --host-header=localhost:11434
# LLM_MODEL=llama3.2
# LLM_API_KEY=ollama
# LLM_BASE_URL=https://<subdomain>.ngrok-free.app/v1

# Default: OpenAI.
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-...
