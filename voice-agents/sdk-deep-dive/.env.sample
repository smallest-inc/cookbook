# platform
SMALLEST_API_KEY=sk_...

# LLM keys. multi_agent_deterministic defaults to OpenAI, compliance_guard defaults
# to Claude. Set the key for the example you run (or both).
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# where a warm transfer sends the caller (compliance_guard)
TRANSFER_CALL_NUMBER=+1...

# Optional. Override the LLM for an example. Leave commented to use each example's
# in-code default (OpenAI gpt-4o-mini, or Claude for compliance_guard).
# CUSTOM_LLM_MODEL=gpt-4o-mini
# CUSTOM_LLM_BASE_URL=https://api.openai.com/v1/
