# Smallest AI API Key
# Get yours at https://smallest.ai/console
SMALLEST_API_KEY=your-smallest-api-key-here

# Optional: port (default 4000)
PORT=4000

# Optional: timezone for slot formatting (default America/Los_Angeles)
CALENDAR_TIMEZONE=America/Los_Angeles

