# Copy to .env and fill in your keys.

# Smallest AI API key — https://app.smallest.ai/dashboard/settings/apikeys
SMALLEST_API_KEY=sk_...

# OpenAI API key — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Cal.com API key + Event Type ID — https://cal.com (Settings → Developer → API keys)
CAL_API_KEY=cal_...
CAL_EVENT_TYPE_ID=

# IANA timezone for booked slots. Optional — defaults to Asia/Kolkata.
# CAL_TIMEZONE=Asia/Kolkata
