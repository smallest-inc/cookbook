# Copy to .env and fill in. The .env ships with the deploy and is read in the pod.

# --- Platform ---
SMALLEST_API_KEY=sk_...                 # from app.smallest.ai/dashboard/api-keys
AGENT_ID=                               # your agent-crew id (create via dashboard or code)
FROM_PRODUCT_ID=                        # telephony product id to place OUTBOUND calls from

# --- LLM (any OpenAI-compatible endpoint) ---
CUSTOM_LLM_BASE_URL=https://api.openai.com/v1/      # Ollama: http://localhost:11434/v1/
CUSTOM_LLM_MODEL=gpt-4o-mini                        # Ollama: e.g. llama3.1
OPENAI_API_KEY=sk-...                               # Ollama: any non-empty string

# --- Transfer ---
TRANSFER_MODE=cold                      # which example to deploy: cold | warm
TRANSFER_CALL_NUMBER=+91XXXXXXXXXX      # REQUIRED. A number a human will ANSWER.

# --- Inbound (optional; run enable_inbound.py) ---
INBOUND_PRODUCT_ID=                     # telephony product id whose number should RING this agent
