# Smallest AI API Key
# Used by the smallestai CLI (auth, agent-crew init/deploy/chat).
# Get yours at https://docs.smallest.ai/overview/administration/api-keys
SMALLEST_API_KEY=your-smallest-api-key-here

# OpenAI API Key
# Used for the image model and the chat model that calls the draw tools.
# Get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Board URL the agent POSTs pictures to.
# Use http://localhost:8765 for local testing.
BOARD_URL=http://localhost:8765

# Shared secret for POST /frame and POST /status.
# Generate one with: openssl rand -hex 16
# Leave empty only for local testing.
BOARD_TOKEN=

# OpenAI image model and quality.
IMAGE_MODEL=gpt-image-2.6-flare
IMAGE_QUALITY=low

# Chat model that decides when to call the draw tools.
CHAT_MODEL=gpt-4.1-mini
