# Rename to .env and fill in.
#
# SMALLEST_API_KEY and AGENT_ID are read by scripts/setup_agent.py and by the
# session server (../mobile_token_server). They are NOT prefixed with
# EXPO_PUBLIC_, so Metro does not put them in the app bundle.
SMALLEST_API_KEY=sk_your_key_here
AGENT_ID=your_agent_id_here

# The only value the app reads. EXPO_PUBLIC_* is inlined into the JS bundle,
# so never put a key here. iOS simulator: http://localhost:8787
# Android emulator: http://10.0.2.2:8787. Physical device: http://<your-LAN-IP>:8787
EXPO_PUBLIC_TOKEN_SERVER_URL=http://localhost:8787
