# Only `uv run booking_retry.py run` reads these. `simulate` and the tests need none of them.

# Smallest AI API key. Get yours at https://app.smallest.ai
SMALLEST_API_KEY=your-smallest-api-key-here

# 24 character id of YOUR booking agent (see create_agent.py)
ATOMS_AGENT_ID=your-agent-id-here

# Country calling codes you are allowed to call, comma separated. Calls to any
# other country are blocked. Leave empty and `run` refuses to start.
BOOKING_ALLOWED_PREFIXES=+1

# Optional: the number to call from (a rented number's product id)
# ATOMS_FROM_PRODUCT_ID=
